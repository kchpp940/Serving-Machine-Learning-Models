# ============================================================
# Car Price Prediction - Shared Environment Configuration
# ============================================================
# 此配置被以下组件共同消费：
#   - FastAPI 服务端 (fastapi/run.sh)
#   - Streamlit 客户端 (streamlitapp/run.sh, streamlit_app.py)
#   - Android/Kivy 客户端 (androidapp/main.py)
#   - 共享 API 客户端 (car_pricing/api_client.py)
#
# 推荐用法（二选一）：
#   1. 安装共享包: pip install -e .  然后复制此文件为 .env
#   2. 开发模式直接使用各子目录下的 run.sh，脚本会自动加载
# ============================================================

# ---------- API 服务端配置 ----------
# FastAPI 监听地址和端口
HOST=0.0.0.0
PORT=8000

# ---------- API 客户端配置（所有客户端共享）----------
# API 基础 URL（不含尾部 /）
#  本地开发:      http://localhost:8000
#  Android 模拟器: http://10.0.2.2:8000  (访问宿主机 localhost)
#  生产部署:      https://your-app.herokuapp.com
API_BASE_URL=http://localhost:8000

# HTTP 请求超时时间（秒）
API_REQUEST_TIMEOUT=10

# ---------- Android 专用覆盖（可选）----------
# Android 默认使用 10.0.2.2 访问宿主机，但可在此覆盖
# ANDROID_API_BASE_URL=http://10.0.2.2:8000
# ANDROID_API_TIMEOUT=15

