# Unified runtime configuration for Serving-Machine-Learning-Models
# Single source of truth: car_pricing.config.export_env_schema()
# Generated by: scripts/generate_config_artifacts.py .env
# Default values are defined in car_pricing/config.py
# Copy this file to .env and adjust as needed

# === API server configuration ===
# API 监听地址
#API_HOST=0.0.0.0

# API 监听端口（Heroku 会自动注入 PORT 环境变量，启动时会映射到此变量）
#API_PORT=8000

# === Model file locations ===
# 模型文件目录。未设置时按优先级解析：./models → ./shared_models → <project_root>/shared_models → <project_root>/models
#MODEL_DIR=./shared_models

# 模型文件名
#MODEL_FILENAME=sklearn_gbr.pkl

# 模型元数据文件名
#MODEL_METADATA_FILENAME=model_metadata.json

# 模型状态文件名
#MODEL_STATUS_FILENAME=model_status.json

# === Training data locations ===
# 训练数据 CSV 文件名
#DATA_CSV_FILENAME=cars.csv

# 训练数据目录。未设置时按优先级解析：./Data → <project_root>/Data
#DATA_DIR=./Data

# === Client configuration ===
# API 基础 URL（供 Streamlit 等客户端调用）
#API_BASE_URL=http://localhost:8000

# 请求超时时间（秒）
#REQUEST_TIMEOUT=10

# === BentoML configuration ===
# BentoML 模型标签
#BENTOML_MODEL_TAG=gbr:latest

