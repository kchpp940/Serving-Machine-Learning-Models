# Unified runtime configuration for Serving-Machine-Learning-Models
# Default values are defined in car_pricing/config.py
# Copy this file to .env and adjust as needed

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model directory (where sklearn_gbr.pkl, model_metadata.json live)
# If not set, will auto-resolve to:
#   1. ./models (if exists and contains sklearn_gbr.pkl)
#   2. <project_root>/models
#MODEL_DIR=./car_pricing_api/models

# Model file names
MODEL_FILENAME=sklearn_gbr.pkl
MODEL_METADATA_FILENAME=model_metadata.json
MODEL_STATUS_FILENAME=model_status.json

# Training data directory
# If not set, will auto-resolve to:
#   1. ./Data (if exists and contains cars.csv)
#   2. <project_root>/Data
#DATA_DIR=./Data

# Data file names
DATA_CSV_FILENAME=cars.csv

# API base URL used by Streamlit client
# Defaults to http://localhost:<API_PORT>
#API_BASE_URL=http://localhost:8000

# Request timeout in seconds (used by Streamlit client)
REQUEST_TIMEOUT=10

# BentoML model tag
BENTOML_MODEL_TAG=gbr:latest
