# 运行时环境变量示例
# =============================================
# 单一真相来源: car_pricing.config.export_env_schema()
# 由 scripts/generate_config_artifacts.py deploy 自动生成
#
# 使用方式:
#   cp .env.example .env
#   # 然后编辑 .env 填入实际值
#
# 注意: <auto-resolved> 表示未设置时会自动按优先级解析
#

# --- API server configuration ---
# API 监听地址 (类型: str)
# API_HOST=0.0.0.0
API_HOST=0.0.0.0
# API 监听端口（Heroku 会自动注入 PORT 环境变量，启动时会映射到此变量） (类型: int)
# API_PORT=8000
API_PORT=8000


# --- Model file locations ---
# 模型文件目录。未设置时按优先级解析：./models → ./shared_models → <project_root>/shared_models → <project_root>/models (类型: str)
# MODEL_DIR=<auto-resolved>
MODEL_DIR=<auto-resolved>
# 模型文件名 (类型: str)
# MODEL_FILENAME=sklearn_gbr.pkl
MODEL_FILENAME=sklearn_gbr.pkl
# 模型元数据文件名 (类型: str)
# MODEL_METADATA_FILENAME=model_metadata.json
MODEL_METADATA_FILENAME=model_metadata.json
# 模型状态文件名 (类型: str)
# MODEL_STATUS_FILENAME=model_status.json
MODEL_STATUS_FILENAME=model_status.json
# Schema snapshot 文件名（训练时由 lineage.persist() 写入完整特征/编码器快照） (类型: str)
# SCHEMA_SNAPSHOT_FILENAME=schema_snapshot.json
SCHEMA_SNAPSHOT_FILENAME=schema_snapshot.json
# Model lineage 文件名（训练时由 lineage.persist() 写入完整血缘记录） (类型: str)
# LINEAGE_FILENAME=model_lineage.json
LINEAGE_FILENAME=model_lineage.json


# --- Training data locations ---
# 训练数据 CSV 文件名 (类型: str)
# DATA_CSV_FILENAME=cars.csv
DATA_CSV_FILENAME=cars.csv
# 训练数据目录。未设置时按优先级解析：./Data → <project_root>/Data (类型: str)
# DATA_DIR=<auto-resolved>
DATA_DIR=<auto-resolved>


# --- Client configuration ---
# API 基础 URL（供 Streamlit 等客户端调用） (类型: str)
# API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
# 请求超时时间（秒） (类型: int)
# REQUEST_TIMEOUT=10
REQUEST_TIMEOUT=10


# --- BentoML configuration ---
# BentoML 模型标签 (类型: str)
# BENTOML_MODEL_TAG=gbr:latest
BENTOML_MODEL_TAG=gbr:latest

