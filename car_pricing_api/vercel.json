{
  "buildCommand": "pip install -r requirements.txt && pip install -e ..",
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": ".",
  "framework": null,
  "build": {
    "env": {
      "API_HOST": "0.0.0.0",
      "API_PORT": "8000",
      "MODEL_DIR": "./shared_models",
      "MODEL_FILENAME": "sklearn_gbr.pkl",
      "MODEL_METADATA_FILENAME": "model_metadata.json",
      "MODEL_STATUS_FILENAME": "model_status.json",
      "DATA_DIR": "./Data",
      "DATA_CSV_FILENAME": "cars.csv",
      "REQUEST_TIMEOUT": "10",
      "BENTOML_MODEL_TAG": "gbr:latest"
    }
  },
  "functions": {
    "app.py": {
      "includeFiles": "**/*.py,**/*.json,**/*.pkl"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/app.py" }
  ]
}
